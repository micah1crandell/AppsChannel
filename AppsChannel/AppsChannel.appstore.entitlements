<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mandatory Mac App Store App Sandbox -->
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- Allow outgoing network connections (for GitHub link and tip jar) -->
	<key>com.apple.security.network.client</key>
	<true/>

	<!-- Allow reading and writing user-selected files (for custom icon and file selection) -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>

	<!-- Allow sending Apple Events to other applications (for activating running apps) -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
